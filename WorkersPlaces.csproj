<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WorkersPlaces</AssemblyName>
    <RootNamespace>WorkersPlaces</RootNamespace>
    <Version>0.2.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <Import Project="GamePath.local.props" Condition="Exists('GamePath.local.props')" />

  <PropertyGroup>
    <LoaderDirectory>$(GamePath)\MelonLoader\net6</LoaderDirectory>
    <InteropDirectory>$(GamePath)\MelonLoader\Il2CppAssemblies</InteropDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(LoaderDirectory)\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(LoaderDirectory)\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(LoaderDirectory)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(InteropDirectory)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(InteropDirectory)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameInstallation" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GamePath)' == ''" Text="Set GamePath in GamePath.local.props (copy GamePath.example.props) or pass -p:GamePath=..." />
    <Error Condition="!Exists('$(GamePath)\GameAssembly.dll')" Text="GamePath must point to the IL2CPP Schedule I installation." />
    <Error Condition="!Exists('$(LoaderDirectory)\MelonLoader.dll')" Text="Install MelonLoader in the selected game folder before building." />
    <Error Condition="!Exists('$(InteropDirectory)\Assembly-CSharp.dll')" Text="Launch the game with MelonLoader once to generate the IL2CPP assemblies before building." />
  </Target>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <Error Condition="!Exists('$(GamePath)\Mods')" Text="The game's Mods directory is missing. Launch the game with MelonLoader first." />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(GamePath)\Mods. Restart the game to load it." />
  </Target>
</Project>
